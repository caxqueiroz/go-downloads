# Copy to terraform.tfvars (gitignored) and fill in.
#
#   terraform init
#   terraform apply     # create
#   terraform destroy   # remove everything, billing stops

sites = {
  "downloads.example.com" = {
    upstream     = "mac-mini-duo:8080"
    strip_prefix = "/downloads"
  }
  "app.example.com" = {
    upstream = "https://mac-mini-duo.example.ts.net"
  }
}

# Reusable + ephemeral key from https://login.tailscale.com/admin/settings/keys
tailscale_auth_key = "tskey-auth-..."

# route53_zone_id   = "Z0123456789ABC"
# ssh_allowed_cidrs = ["203.0.113.4/32"]
